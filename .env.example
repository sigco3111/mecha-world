# =============================================================================
# MECHA WORLD: NEXUS — AI 后端环境变量（GDD §37.4）
# 复制为 .env 后填写真实值；前端零密钥，所有 key 仅存后端。
# =============================================================================

# ---- LLM（主备双提供商，至少配一个；都没有则走 MockProvider 跑通管线）----
LLM_PRIMARY_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_CHAT=deepseek-v4-flash
LLM_PRIMARY_LITE=deepseek-v4-flash

LLM_BACKUP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BACKUP_API_KEY=
LLM_BACKUP_CHAT=gemini-2.0-flash

# ---- Embedding（lore RAG / 情节记忆向量化；留空则走内存 TF 向量兜底）----
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3.0
# 向量维度（必须与所选模型一致；内存兜底固定 256）
EMBEDDING_DIM=1024

# ---- 基础设施（留空则 ai-server 用进程内内存兜底，无需 docker）----
REDIS_URL=
QDRANT_URL=
QDRANT_COLLECTION_LORE=nexus_lore
QDRANT_COLLECTION_EPISODIC=nexus_episodic

# ---- 服务 ----
PORT=8787
LOG_LEVEL=info
# 前端来源（GitHub Pages + 本地开发），逗号分隔
CORS_ORIGIN=https://ytyangtao666.github.io,http://127.0.0.1:5173,http://localhost:5173

# ---- 成本与降级（GDD §8.10/§8.12）----
DAILY_BUDGET_CNY=30
ALERT_MAIL=
